<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/recordingsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Conference recordings"
        android:textAppearance="?attr/textAppearanceHeadline6" />

    <TextView
        android:id="@+id/recordingsSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Loading recordings..." />

    <Button
        android:id="@+id/recordingsClearButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Clear list" />

    <Button
        android:id="@+id/recordingsRefreshButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Refresh" />

    <TextView
        android:id="@+id/recordingsEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="No recording links have been received yet."
        android:visibility="gone" />

    <ListView
        android:id="@+id/recordingsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />
</LinearLayout>
