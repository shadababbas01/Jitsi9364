+    /** Receives a copy of the PCM captured by WebRTC's call microphone. */
+    public interface AudioSamplesListener {
+        void onAudioSamples(int audioFormat, int channelCount, int sampleRate, byte[] data);
+    }
+
+    private static volatile AudioSamplesListener audioSamplesListener;
+
+    public static void setAudioSamplesListener(AudioSamplesListener listener) {
+        audioSamplesListener = listener;
+    }
+
+    public static void clearAudioSamplesListener(AudioSamplesListener listener) {
+        if (audioSamplesListener == listener) {
+            audioSamplesListener = null;
+        }
+    }
+
+    private static void onAudioSamplesReady(JavaAudioDeviceModule.AudioSamples samples) {
+        AudioSamplesListener listener = audioSamplesListener;
+
+        if (listener == null) {
+            return;
+        }
+
+        byte[] data = samples.getData();
+
+        listener.onAudioSamples(
+            samples.getAudioFormat(),
+            samples.getChannelCount(),
+            samples.getSampleRate(),
+            data.clone());
+    }
